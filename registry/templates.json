        "type": "text",
        "required": true,
        "description": "The role the assistant should take",
        "default": "Senior product strategist"
      },
      {
        "name": "COMPANY",
        "type": "text",
        "required": true,
        "description": "Organization or project context"
      },
      {
        "name": "OBJECTIVE",
        "type": "long-text",
        "required": true,
        "description": "What should be achieved?"
      },
      {
        "name": "TARGET_AUDIENCE",
        "type": "text",
        "required": true,
        "description": "Who will use or read the output?"
      },
      {
        "name": "OUTPUT_FORMAT",
        "type": "select",
        "required": true,
        "description": "Preferred format",
        "options": [
          "Brief",
          "Table",
          "Checklist",
          "JSON"
        ],
        "default": "Brief"
      }
    ]
